{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-assurance.example/schemas/dats-catalog-1.0.json",
  "title": "DATS Gold Dataset Catalog",
  "type": "object",
  "required": ["schema_version", "dataset_id", "dataset_version", "status", "cases"],
  "properties": {
    "schema_version": {"const": "decision-assurance.dats-catalog/1.0"},
    "dataset_id": {"const": "decision-assurance-gold"},
    "dataset_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["DRAFT", "ACCEPTED", "RETIRED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "license": {"type": "string", "minLength": 1},
    "case_count": {"type": "integer", "minimum": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": {"type": "string", "pattern": "^DATS-[0-9]{3}$"},
          "path": {"type": "string", "pattern": "^cases/DATS-[0-9]{3}\\.json$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
