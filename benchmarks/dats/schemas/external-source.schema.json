{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-assurance.example/schemas/external-source-1.0.json",
  "title": "DATS External Source Record",
  "type": "object",
  "required": [
    "schema_version", "source_id", "title", "publisher", "version", "published_at",
    "landing_page", "retrieved_at", "local_copy_included", "assurance_use", "mapping_status"
  ],
  "properties": {
    "schema_version": {"const": "decision-assurance.external-source/1.0"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 5},
    "publisher": {"type": "string", "minLength": 2},
    "version": {"type": "string", "minLength": 1},
    "published_at": {"type": "string", "format": "date"},
    "landing_page": {"type": "string", "format": "uri"},
    "download_endpoint": {"type": "string", "format": "uri"},
    "retrieved_at": {"type": "string", "format": "date"},
    "license_note": {"type": "string", "minLength": 1},
    "local_copy_included": {"type": "boolean"},
    "assurance_use": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "mapping_status": {"const": "PROJECT_INTERPRETATION_NOT_OWASP_ENDORSEMENT"},
    "limits": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
