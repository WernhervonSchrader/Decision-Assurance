{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-assurance.example/schemas/production/pilot-export.schema.json",
  "title": "Decision Assurance portable pilot export manifest v0.8",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "export_id", "case_ref", "generated_at", "software", "policy_versions", "members"],
  "properties": {
    "schema_version": {"const": "0.8.0"},
    "export_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "case_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "generated_at": {"type": "string", "format": "date-time"},
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit_sha"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      }
    },
    "policy_versions": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*\\.json$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 2, "maximum": 10485760}
        }
      }
    }
  }
}
