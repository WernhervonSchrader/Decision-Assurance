{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-assurance.example/schemas/production/pilot-profile.schema.json",
  "title": "Controlled Pilot Profile v0.5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "use_case", "maximum_users", "maximum_tenants", "maximum_research_budget", "maximum_research_concurrency", "supported_locales", "supported_providers", "allowed_data_classes", "retention_days", "feature_flags", "escalation_process", "stop_criteria", "human_approval_required"],
  "properties": {
    "schema_version": {"const": "0.5.0"},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "use_case": {"const": "Sales Quote Review"},
    "maximum_users": {"type": "integer", "minimum": 1},
    "maximum_tenants": {"type": "integer", "minimum": 1},
    "maximum_research_budget": {"type": "integer", "minimum": 1},
    "maximum_research_concurrency": {"type": "integer", "minimum": 1},
    "supported_locales": {"type": "array", "minItems": 2, "uniqueItems": true, "contains": {"const": "de"}, "items": {"enum": ["de", "en"]}},
    "supported_providers": {"type": "array", "uniqueItems": true, "items": {"enum": ["brave-search", "firecrawl"]}},
    "allowed_data_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "retention_days": {"type": "integer", "minimum": 1},
    "feature_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "escalation_process": {"type": "string", "minLength": 1},
    "stop_criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "human_approval_required": {"const": true}
  }
}
