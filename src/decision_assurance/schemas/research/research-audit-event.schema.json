{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-assurance.org/schemas/research/research-audit-event.schema.json",
  "title": "Research Audit Event v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "occurred_at", "tenant_id", "actor_id", "from_status", "to_status", "reason_codes", "correlation_id", "payload_hash", "previous_event_hash", "schema_version"],
  "properties": {
    "event_id": {"type": "string"}, "event_type": {"enum": ["research.status-transitioned", "research.egress-decision"]}, "occurred_at": {"type": "string", "format": "date-time"},
    "tenant_id": {"type": "string"}, "actor_id": {"type": "string"}, "from_status": {"type": "string"}, "to_status": {"type": "string"},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "correlation_id": {"type": "string"}, "payload_hash": {"type": "string"}, "previous_event_hash": {"type": ["string", "null"]},
    "schema_version": {"enum": ["research-audit-v1", "research-egress-decision-v1"]}, "decision": {"type": ["string", "null"], "enum": ["ALLOWED", "BLOCKED", null]},
    "operating_profile": {"type": ["string", "null"]}, "policy_version": {"type": ["string", "null"]}, "provider": {"type": ["string", "null"]},
    "connector": {"type": ["string", "null"]}, "target_host": {"type": ["string", "null"]}, "requested_processing_location": {"type": ["string", "null"]},
    "evidence_id": {"type": ["string", "null"]}, "evidence_status": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"event_type": {"const": "research.egress-decision"}}},
      "then": {
        "required": ["decision", "operating_profile", "policy_version", "provider", "connector", "target_host", "requested_processing_location", "evidence_id", "evidence_status"],
        "properties": {"schema_version": {"const": "research-egress-decision-v1"}}
      },
      "else": {"properties": {"schema_version": {"const": "research-audit-v1"}}}
    }
  ]
}
