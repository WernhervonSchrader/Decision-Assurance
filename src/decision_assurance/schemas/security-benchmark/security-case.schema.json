{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-assurance.example/schemas/security-case/0.1",
  "title": "Security benchmark case v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "test_id": {
      "type": "string",
      "pattern": "^DA-SEC-[A-Z0-9-]+$"
    },
    "schema_version": {
      "const": "0.1"
    },
    "source": {
      "enum": [
        "project-adversarial",
        "microsoft-llmail-inject",
        "microsoft-llmail-fp"
      ]
    },
    "source_record_id": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "family": {
      "type": "string",
      "pattern": "^(A|B[0-6]|C[0-7])$"
    },
    "variant": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "attack_category": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "indirect_prompt_injection",
          "instruction_override",
          "authority_spoofing",
          "role_spoofing",
          "tool_output_injection",
          "retrieved_document_injection",
          "data_exfiltration",
          "workflow_hijacking",
          "context_manipulation",
          "encoded_payload",
          "benign_malicious_mixing",
          "unclassified",
          "governance",
          "execution",
          "benign_control"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "classification_origin": {
      "enum": [
        "project-derived-heuristic-v0.1",
        "project-authored",
        "source-benign-corpus"
      ]
    },
    "attack_surface": {
      "enum": [
        "email_body",
        "decision_file",
        "execution_context"
      ]
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "trust_boundary": {
      "enum": [
        "untrusted_content_to_agent",
        "generator_to_governance",
        "approval_to_execution"
      ]
    },
    "payload_reference": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "offset",
            "length",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "expected_security_property": {
      "const": "no_unauthorized_execution"
    },
    "expected_outcome": {
      "enum": [
        "BLOCK",
        "REVIEW",
        "PASS",
        "UNASSESSED"
      ]
    },
    "execution_mode": {
      "const": "simulation"
    },
    "tenant_id": {
      "enum": [
        "tenant-a",
        "tenant-b"
      ]
    },
    "locale": {
      "enum": [
        "en",
        "de"
      ]
    },
    "unauthorized": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "attack_ground_truth": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "original_result": {
      "type": [
        "object",
        "null"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_revision",
        "license",
        "content_sha256"
      ],
      "properties": {
        "dataset_revision": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "original_attack_label": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "test_id",
    "schema_version",
    "source",
    "source_record_id",
    "layer",
    "family",
    "variant",
    "attack_category",
    "classification_origin",
    "attack_surface",
    "scenario",
    "trust_boundary",
    "payload_reference",
    "expected_security_property",
    "expected_outcome",
    "execution_mode",
    "tenant_id",
    "locale",
    "unauthorized",
    "attack_ground_truth",
    "original_result",
    "provenance",
    "original_attack_label"
  ]
}
