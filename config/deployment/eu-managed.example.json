{
  "profile": "production",
  "operating_mode": "eu-managed",
  "data_residency": {
    "storage_locations": ["DE"],
    "processing_locations": ["DE", "IE"],
    "backup_locations": ["DE", "IE"],
    "support_access_locations": ["DE", "NL"],
    "external_processing_locations": ["DE"],
    "evidence_refs": [
      "https://compliance.example/eu-residency",
      "https://compliance.example/eu-subprocessors"
    ]
  },
  "database_backend": "postgresql",
  "authentication_mode": "oidc",
  "secret_provider": "external",
  "database_dsn_secret": "decision-assurance-database-dsn",
  "worker_database_dsn_secret": "decision-assurance-worker-database-dsn",
  "oidc": {
    "issuer": "https://identity.eu.example",
    "audience": "decision-assurance",
    "jwks_uri": "https://identity.eu.example/.well-known/jwks.json",
    "algorithms": ["RS256"],
    "tenant_claim": "tenant_id",
    "actor_id_claim": "sub",
    "role_claim": "realm_access.roles",
    "actor_kind_claim": "actor_kind",
    "organization_claim": "organization",
    "groups_claim": "groups",
    "clock_skew_seconds": 30,
    "authorized_parties": ["decision-assurance-ui"],
    "required_scopes": ["da.api"],
    "allow_insecure_loopback": false
  },
  "egress_allowed_hosts": [
    "research-extract.eu.example",
    "openai-api.eu.example"
  ],
  "provider_egress": [
    {
      "provider": "firecrawl",
      "service": "scrape-v2",
      "host": "research-extract.eu.example",
      "processing_location": "DE",
      "confirmed_processing_locations": [],
      "tenant_ids": ["*"],
      "attestation": {
        "evidence_id": "eu-firecrawl-attestation-pending",
        "evidence_type": "OPERATOR_SELF_DECLARATION",
        "evidence_ref": "https://invalid.example/evidence-not-verified",
        "issuer": "operator",
        "issued_at": "2026-01-01T00:00:00Z",
        "valid_from": "2026-01-01T00:00:00Z",
        "expires_at": "2027-01-01T00:00:00Z",
        "verification_status": "UNVERIFIED",
        "verified_at": null,
        "verified_by": null,
        "document_hash": null
      }
    },
    {
      "provider": "openai-web-search",
      "service": "responses-web-search-v1",
      "host": "openai-api.eu.example",
      "processing_location": "DE",
      "confirmed_processing_locations": [],
      "tenant_ids": ["*"],
      "attestation": {
        "evidence_id": "eu-openai-attestation-pending",
        "evidence_type": "OPERATOR_SELF_DECLARATION",
        "evidence_ref": "https://invalid.example/evidence-not-verified",
        "issuer": "operator",
        "issued_at": "2026-01-01T00:00:00Z",
        "valid_from": "2026-01-01T00:00:00Z",
        "expires_at": "2027-01-01T00:00:00Z",
        "verification_status": "UNVERIFIED",
        "verified_at": null,
        "verified_by": null,
        "document_hash": null
      }
    }
  ],
  "worker": {
    "max_attempts": 5,
    "lease_seconds": 60,
    "base_backoff_seconds": 5,
    "maximum_backoff_seconds": 300
  }
}
