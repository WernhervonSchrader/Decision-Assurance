{
  "profile": "production",
  "operating_mode": "local",
  "data_residency": {
    "storage_locations": ["local"],
    "processing_locations": ["local"],
    "backup_locations": ["local"],
    "support_access_locations": ["local"],
    "external_processing_locations": ["local"],
    "evidence_refs": []
  },
  "database_backend": "postgresql",
  "authentication_mode": "oidc",
  "secret_provider": "external",
  "database_dsn_secret": "decision-assurance-database-dsn",
  "worker_database_dsn_secret": "decision-assurance-worker-database-dsn",
  "oidc": {
    "issuer": "https://identity.local.example",
    "audience": "decision-assurance",
    "jwks_uri": "https://identity.local.example/.well-known/jwks.json",
    "algorithms": ["RS256"],
    "tenant_claim": "tenant_id",
    "actor_id_claim": "sub",
    "role_claim": "role",
    "actor_kind_claim": "actor_kind",
    "organization_claim": "organization",
    "groups_claim": "groups",
    "clock_skew_seconds": 30
  },
  "egress_allowed_hosts": [
    "research-extract.local.example",
    "research-search.local.example"
  ],
  "provider_egress": [
    {
      "provider": "firecrawl",
      "service": "scrape-v2",
      "host": "research-extract.local.example",
      "processing_location": "local",
      "confirmed_processing_locations": [],
      "tenant_ids": ["*"],
      "attestation": {
        "evidence_id": "local-firecrawl-attestation-pending",
        "evidence_type": "OPERATOR_SELF_DECLARATION",
        "evidence_ref": "https://invalid.example/evidence-not-verified",
        "issuer": "operator",
        "issued_at": "2026-01-01T00:00:00Z",
        "valid_from": "2026-01-01T00:00:00Z",
        "expires_at": "2027-01-01T00:00:00Z",
        "verification_status": "UNVERIFIED",
        "verified_at": null,
        "verified_by": null,
        "document_hash": null
      }
    },
    {
      "provider": "brave-search",
      "service": "web-search-v1",
      "host": "research-search.local.example",
      "processing_location": "local",
      "confirmed_processing_locations": [],
      "tenant_ids": ["*"],
      "attestation": {
        "evidence_id": "local-brave-attestation-pending",
        "evidence_type": "OPERATOR_SELF_DECLARATION",
        "evidence_ref": "https://invalid.example/evidence-not-verified",
        "issuer": "operator",
        "issued_at": "2026-01-01T00:00:00Z",
        "valid_from": "2026-01-01T00:00:00Z",
        "expires_at": "2027-01-01T00:00:00Z",
        "verification_status": "UNVERIFIED",
        "verified_at": null,
        "verified_by": null,
        "document_hash": null
      }
    }
  ],
  "worker": {
    "max_attempts": 5,
    "lease_seconds": 60,
    "base_backoff_seconds": 5,
    "maximum_backoff_seconds": 300
  }
}
