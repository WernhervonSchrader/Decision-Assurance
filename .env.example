# Select a non-secret typed configuration document.
DA_CONFIG_PATH=config/production.example.json

# Choose one production operating profile. Do not use the SQLite reference runtime for either path.
# DA_CONFIG_PATH=config/deployment/local.example.json
# DA_CONFIG_PATH=config/deployment/eu-managed.example.json
# Development/pilot provider integration only; never evidence for production approval:
# DA_CONFIG_PATH=config/deployment/provider-development.example.json
# Keycloak + provider development only; requires the isolated local Compose stack:
# DA_CONFIG_PATH=config/deployment/keycloak-development.example.json
# DA_SECRET_DIRECTORY=.secrets
# Match these URLs to the exact egress hosts declared by the selected profile.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_WEB_SEARCH_MODEL=gpt-5.6
FIRECRAWL_BASE_URL=https://research-extract.local.example

# References only. The deployment's external secret provider resolves these names.
DA_DATABASE_DSN_SECRET_REF=decision-assurance-database-dsn
DA_WORKER_DATABASE_DSN_SECRET_REF=decision-assurance-worker-database-dsn
DA_OPENAI_API_KEY_SECRET_REF=OPENAI_API_KEY
DA_FIRECRAWL_API_KEY_SECRET_REF=FIRECRAWL_API_KEY

# Keycloak bootstrap/database values are Docker secret files under .secrets/; see docs/KEYCLOAK.md.

# MCP resource-server metadata and inbound DNS-rebinding allowlists. Replace example URLs at deploy.
DA_MCP_HOST=0.0.0.0
DA_MCP_PORT=8001
DA_MCP_ISSUER_URL=https://identity.example.com
DA_MCP_RESOURCE_SERVER_URL=https://mcp.decision-assurance.example
DA_MCP_ALLOWED_HOSTS=mcp.decision-assurance.example
DA_MCP_ALLOWED_ORIGINS=https://chatgpt.com

# Build metadata is injected by the release pipeline.
DA_VERSION=0.5.0
DA_COMMIT_SHA=
DA_BUILD_TIMESTAMP=
