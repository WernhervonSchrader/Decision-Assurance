# Select a non-secret typed configuration document.
DA_CONFIG_PATH=config/production.example.json

# References only. The deployment's external secret provider resolves these names.
DA_DATABASE_DSN_SECRET_REF=decision-assurance-database-dsn
DA_WORKER_DATABASE_DSN_SECRET_REF=decision-assurance-worker-database-dsn
DA_BRAVE_API_KEY_SECRET_REF=decision-assurance-brave-api-key
DA_FIRECRAWL_API_KEY_SECRET_REF=decision-assurance-firecrawl-api-key

# MCP resource-server metadata and inbound DNS-rebinding allowlists. Replace example URLs at deploy.
DA_MCP_HOST=0.0.0.0
DA_MCP_PORT=8001
DA_MCP_ISSUER_URL=https://identity.example.com
DA_MCP_RESOURCE_SERVER_URL=https://mcp.decision-assurance.example
DA_MCP_ALLOWED_HOSTS=mcp.decision-assurance.example
DA_MCP_ALLOWED_ORIGINS=https://chatgpt.com

# Build metadata is injected by the release pipeline.
DA_VERSION=0.5.0
DA_COMMIT_SHA=
DA_BUILD_TIMESTAMP=
