{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-assurance.org/schemas/research/research-request.schema.json",
  "title": "Research Request v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_file_id", "claim_refs", "query", "locale", "preferred_languages", "max_search_results", "max_sources_to_extract", "allowed_domains", "blocked_domains", "freshness", "research_policy", "force_refresh"],
  "properties": {
    "schema_version": {"const": "0.4.0"},
    "decision_file_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "claim_refs": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "query": {"type": "string", "minLength": 1, "maxLength": 400},
    "locale": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "preferred_languages": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"}},
    "max_search_results": {"type": "integer", "minimum": 1, "maximum": 20},
    "max_sources_to_extract": {"type": "integer", "minimum": 1, "maximum": 10},
    "allowed_domains": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string"}},
    "blocked_domains": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string"}},
    "freshness": {"type": "object", "additionalProperties": false, "required": ["maximum_age_days", "prefer_recent"], "properties": {"maximum_age_days": {"type": "integer", "minimum": 1, "maximum": 3650}, "prefer_recent": {"type": "boolean"}}},
    "research_policy": {"enum": ["standard", "high-assurance"]},
    "force_refresh": {"type": "boolean"},
    "refresh_generation": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}
  }
}
