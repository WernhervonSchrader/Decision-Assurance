{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-assurance.org/schemas/research/evidence-candidate.schema.json",
  "title": "Evidence Candidate v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "tenant_id", "research_run_id", "decision_file_id", "claim_refs", "source_id", "snapshot_id", "content_hash", "assessment", "provenance", "risk"],
  "properties": {
    "evidence_id": {"type": "string"}, "tenant_id": {"type": "string"}, "research_run_id": {"type": "string"}, "decision_file_id": {"type": "string"},
    "claim_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "source_id": {"type": "string"}, "snapshot_id": {"type": "string"}, "content_hash": {"type": "string"},
    "assessment": {"$ref": "evidence-assessment.schema.json"},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["search_result_rank", "search_query", "search_provider", "search_provider_version", "content_provider", "content_provider_version", "policy_version"], "properties": {"search_result_rank": {"type": "integer"}, "search_query": {"type": "string"}, "search_provider": {"type": "string"}, "search_provider_version": {"type": "string"}, "content_provider": {"type": "string"}, "content_provider_version": {"type": "string"}, "policy_version": {"type": "string"}}},
    "risk": {"type": "object"}
  }
}
