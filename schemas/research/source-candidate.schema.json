{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-assurance.org/schemas/research/source-candidate.schema.json",
  "title": "Source Candidate v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "original_url", "canonical_url", "domain", "title", "snippet", "rank", "searched_at", "search_provider", "search_provider_version", "status", "reason_codes"],
  "properties": {
    "source_id": {"type": "string"}, "original_url": {"type": "string"}, "canonical_url": {"type": "string"}, "domain": {"type": "string"},
    "title": {"type": "string"}, "snippet": {"type": "string"}, "rank": {"type": "integer", "minimum": 1},
    "searched_at": {"type": "string"}, "search_provider": {"type": "string"}, "search_provider_version": {"type": "string"},
    "published_at": {"type": ["string", "null"]}, "status": {"type": "string"},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
