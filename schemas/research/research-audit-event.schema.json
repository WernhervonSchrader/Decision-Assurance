{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-assurance.org/schemas/research/research-audit-event.schema.json",
  "title": "Research Audit Event v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "occurred_at", "tenant_id", "actor_id", "from_status", "to_status", "reason_codes", "correlation_id", "payload_hash", "previous_event_hash"],
  "properties": {
    "event_id": {"type": "string"}, "event_type": {"const": "research.status-transitioned"}, "occurred_at": {"type": "string", "format": "date-time"},
    "tenant_id": {"type": "string"}, "actor_id": {"type": "string"}, "from_status": {"type": "string"}, "to_status": {"type": "string"},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "correlation_id": {"type": "string"}, "payload_hash": {"type": "string"}, "previous_event_hash": {"type": ["string", "null"]}
  }
}
