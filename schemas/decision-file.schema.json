{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-assurance.org/schemas/decision-file/0.1.0",
  "title": "Decision File Contract",
  "description": "Normative agent-independent case record for Decision Assurance Public Draft v0.1.x.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "title", "description", "use_case", "status", "assurance_level", "created_at", "updated_at", "created_by", "current_owner", "claims", "evidence", "assumptions", "constraints", "policies", "risks", "conflicts", "validation_results", "review_requirements", "approvals", "decision_outcome", "outcome_reasons", "audit_events"],
  "properties": {
    "schema_version": {"const": "0.1.0", "description": "Contract version; unsupported versions MUST be rejected."},
    "decision_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "description": {"type": "string", "minLength": 1},
    "use_case": {"type": "string", "minLength": 1, "maxLength": 100},
    "status": {"enum": ["DRAFT", "VALIDATION", "REVIEW", "APPROVED", "BLOCKED"]},
    "assurance_level": {"enum": ["BASIC", "STANDARD", "HIGH"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "created_by": {"$ref": "#/$defs/actor"},
    "current_owner": {"$ref": "#/$defs/actor"},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}, "minItems": 1},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}},
    "policies": {"type": "array", "items": {"$ref": "#/$defs/policy"}},
    "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
    "validation_results": {"type": "array", "items": {"$ref": "#/$defs/validation"}},
    "review_requirements": {"type": "array", "items": {"$ref": "#/$defs/reviewRequirement"}},
    "approvals": {"type": "array", "items": {"$ref": "#/$defs/approval"}},
    "decision_outcome": {"type": ["string", "null"], "enum": ["PASS", "REVIEW", "BLOCK", null]},
    "outcome_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "audit_events": {"type": "array", "items": {"$ref": "#/$defs/auditEvent"}}
  },
  "$defs": {
    "actor": {"type": "object", "additionalProperties": false, "required": ["id", "role", "kind"], "properties": {"id": {"type": "string", "minLength": 1}, "role": {"enum": ["GENERATOR", "VALIDATOR", "REVIEWER", "APPROVER", "OWNER", "SYSTEM"]}, "kind": {"enum": ["HUMAN", "AGENT", "SERVICE"]}}},
    "claim": {"type": "object", "additionalProperties": false, "required": ["id", "statement", "mandatory_evidence"], "properties": {"id": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "mandatory_evidence": {"type": "boolean"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["id", "claim_refs", "source_ref", "status"], "properties": {"id": {"type": "string", "minLength": 1}, "claim_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}, "source_ref": {"type": "string", "minLength": 1}, "status": {"enum": ["VERIFIED", "UNVERIFIED", "OUTDATED", "CONFLICTING", "FABRICATED", "UNAVAILABLE"]}, "observed_at": {"type": "string", "format": "date-time"}, "content_hash": {"type": "string"}}},
    "assumption": {"type": "object", "additionalProperties": false, "required": ["id", "statement", "status"], "properties": {"id": {"type": "string"}, "statement": {"type": "string", "minLength": 1}, "status": {"enum": ["ACCEPTED", "UNVERIFIED", "REJECTED"]}}},
    "constraint": {"type": "object", "additionalProperties": false, "required": ["id", "severity", "satisfied", "reason_code"], "properties": {"id": {"type": "string"}, "severity": {"enum": ["MANDATORY", "REVIEW_REQUIRED", "ADVISORY"]}, "satisfied": {"type": "boolean"}, "reason_code": {"type": "string", "minLength": 1}}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["id", "version", "requires_review"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "requires_review": {"type": "boolean"}}},
    "risk": {"type": "object", "additionalProperties": false, "required": ["id", "level", "unresolved"], "properties": {"id": {"type": "string"}, "level": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]}, "unresolved": {"type": "boolean"}}},
    "conflict": {"type": "object", "additionalProperties": false, "required": ["id", "severity", "resolved"], "properties": {"id": {"type": "string"}, "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]}, "resolved": {"type": "boolean"}, "description": {"type": "string"}}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["validator", "result", "reason_codes", "validated_at"], "properties": {"validator": {"$ref": "#/$defs/actor"}, "result": {"enum": ["PASS", "REVIEW", "BLOCK"]}, "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "validated_at": {"type": "string", "format": "date-time"}}},
    "reviewRequirement": {"type": "object", "additionalProperties": false, "required": ["id", "required_role", "mandatory", "satisfied"], "properties": {"id": {"type": "string"}, "required_role": {"enum": ["REVIEWER", "APPROVER"]}, "mandatory": {"type": "boolean"}, "satisfied": {"type": "boolean"}}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["requirement_ref", "actor", "decision", "decided_at"], "properties": {"requirement_ref": {"type": "string"}, "actor": {"$ref": "#/$defs/actor"}, "decision": {"enum": ["APPROVE", "REJECT"]}, "decided_at": {"type": "string", "format": "date-time"}}},
    "auditEvent": {"type": "object", "additionalProperties": false, "required": ["event_id", "event_type", "occurred_at", "actor", "from_status", "to_status", "reason_codes", "payload_hash", "previous_event_hash"], "properties": {"event_id": {"type": "string"}, "event_type": {"type": "string"}, "occurred_at": {"type": "string", "format": "date-time"}, "actor": {"$ref": "#/$defs/actor"}, "from_status": {"type": ["string", "null"], "enum": ["DRAFT", "VALIDATION", "REVIEW", "APPROVED", "BLOCKED", null]}, "to_status": {"enum": ["DRAFT", "VALIDATION", "REVIEW", "APPROVED", "BLOCKED"]}, "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "payload_hash": {"type": "string"}, "previous_event_hash": {"type": ["string", "null"]}}}
  }
}
