{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://decision-assurance.org/schemas/intake/candidate-fact/0.3.0","title":"CandidateFact","type":"object","required":["fact_id","fact_type","raw_value","normalized_value","source","method","method_version","extraction_confidence","verification_status","confirmation_required"],"properties":{"fact_id":{"type":"string","minLength":1},"fact_type":{"enum":["AMOUNT","DISCOUNT_PERCENT","DISCOUNT_LIMIT_PERCENT","MARGIN_PERCENT","MIN_MARGIN_PERCENT","PAYMENT_TERM_DAYS","DURATION_MONTHS","DATE","EVIDENCE_DATE","POLICY_CLAIM","EXCEPTION_CLAIM","APPROVAL_CLAIM","SELF_APPROVAL_CLAIM","ROLE_CLAIM","UNTRUSTED_INSTRUCTION"]},"raw_value":{"type":"string"},"normalized_value":{"type":["string","null"]},"source":{"type":"object","required":["source_id","start","end","content_hash"],"properties":{"source_id":{"type":"string","minLength":1},"start":{"type":"integer","minimum":0},"end":{"type":"integer","minimum":0},"content_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},"additionalProperties":false},"method":{"type":"string","minLength":1},"method_version":{"type":"string","minLength":1},"extraction_confidence":{"type":"number","minimum":0,"maximum":1},"verification_status":{"enum":["UNRESOLVED","VERIFIED","HUMAN_CONFIRMED","REJECTED"]},"unit":{"type":["string","null"]},"currency":{"type":["string","null"]},"conflict_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},"confirmation_required":{"type":"boolean"},"confirmed_by_actor_id":{"type":["string","null"]},"confirmed_by_role":{"type":["string","null"],"enum":["VALIDATOR","APPROVER",null]}},"additionalProperties":false}
