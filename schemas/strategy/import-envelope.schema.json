{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "producer": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "locator": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "source_commit": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Commit"
        },
        "local_modifications": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Local Modifications"
        },
        "file_hashes": {
          "additionalProperties": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "propertyNames": {
            "maxLength": 4096,
            "minLength": 1
          },
          "title": "File Hashes",
          "type": "object"
        },
        "test_reports": {
          "items": {
            "$ref": "#/$defs/TestReport"
          },
          "maxItems": 100,
          "title": "Test Reports",
          "type": "array"
        }
      },
      "required": [
        "producer",
        "locator",
        "source_commit",
        "local_modifications",
        "file_hashes",
        "test_reports"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "TestCheck": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "ERROR",
            "SKIP",
            "NOT_REPRODUCED",
            "EXPECTED_REJECTION"
          ],
          "title": "Status",
          "type": "string"
        },
        "expected_rejection": {
          "title": "Expected Rejection",
          "type": "boolean"
        },
        "subject_ref": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subject Ref"
        }
      },
      "required": [
        "id",
        "required",
        "status",
        "expected_rejection",
        "subject_ref"
      ],
      "title": "TestCheck",
      "type": "object"
    },
    "TestReport": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "method": {
          "enum": [
            "cli",
            "function",
            "static",
            "manual"
          ],
          "title": "Method",
          "type": "string"
        },
        "subject": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Ref"
        },
        "source_commit": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Commit"
        },
        "file_hashes": {
          "additionalProperties": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "propertyNames": {
            "maxLength": 4096,
            "minLength": 1
          },
          "title": "File Hashes",
          "type": "object"
        },
        "local_modifications": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Local Modifications"
        },
        "execution_status": {
          "enum": [
            "COMPLETED",
            "ERROR",
            "NOT_EXECUTED",
            "INCOMPLETE"
          ],
          "title": "Execution Status",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        },
        "checked_objects": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Checked Objects",
          "type": "integer"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/TestCheck"
          },
          "maxItems": 1000,
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "id",
        "method",
        "subject",
        "source_ref",
        "source_commit",
        "file_hashes",
        "local_modifications",
        "execution_status",
        "exit_code",
        "checked_objects",
        "checks"
      ],
      "title": "TestReport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter_version": {
      "const": "rif-3.4-rc3/da-1",
      "title": "Adapter Version",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "decision_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Decision Id",
      "type": "string"
    },
    "expected_document_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Expected Document Hash",
      "type": "string"
    },
    "mode": {
      "enum": [
        "draft",
        "baseline",
        "observation"
      ],
      "title": "Mode",
      "type": "string"
    },
    "content_language": {
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "title": "Content Language",
      "type": "string"
    },
    "selected_option_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Option Id"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "artifact": {
      "additionalProperties": true,
      "title": "Artifact",
      "type": "object"
    }
  },
  "required": [
    "adapter_version",
    "tenant_id",
    "decision_id",
    "expected_document_hash",
    "mode",
    "content_language",
    "selected_option_id",
    "provenance",
    "artifact"
  ],
  "title": "ImportEnvelope",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:decision-assurance:strategy:rif-3.4-rc3:da-1"
}
