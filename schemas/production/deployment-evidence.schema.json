{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-assurance.example/schemas/production/deployment-evidence.schema.json",
  "title": "Decision Assurance deployment evidence bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deployment_id", "tenant_id", "profile", "commit_sha", "image_digests", "sbom_checksums", "config_checksums", "evidence", "provider_residency_status", "open_risks", "creator", "created_at", "status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "deployment_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "profile": {"const": "controlled-pilot"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "image_digests": {"$ref": "#/$defs/digests"},
    "sbom_checksums": {"$ref": "#/$defs/digests"},
    "config_checksums": {"$ref": "#/$defs/digests"},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "provider_residency_status": {"enum": ["VERIFIED", "ACCESS_BLOCKED"]},
    "open_risks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "creator": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["INCOMPLETE", "TECHNICALLY_VERIFIED", "PILOT_REVIEW_REQUIRED", "PILOT_ACCEPTED", "BLOCKED"]}
  },
  "$defs": {
    "digests": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["kind", "verified", "observed_at", "digest", "source", "deployment_id", "tenant_id", "commit_sha"], "properties": {"kind": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}, "verified": {"type": "boolean"}, "observed_at": {"type": "string", "format": "date-time"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "source": {"enum": ["MEASURED", "REPOSITORY", "SELF_DECLARED"]}, "deployment_id": {"type": "string", "minLength": 1}, "tenant_id": {"type": "string", "minLength": 1}, "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}}}
  }
}
