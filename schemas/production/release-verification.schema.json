{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-assurance.example/schemas/production/release-verification.schema.json",
  "title": "Release Verification Report v0.5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "commit_sha", "generated_at", "status", "gates"],
  "properties": {
    "schema_version": {"const": "0.5.0"},
    "version": {"const": "0.5.0"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["PASS", "REVIEW", "BLOCK"]},
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "status", "reason_codes", "evidence_refs"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "status": {"enum": ["PASS", "REVIEW", "BLOCK"]},
          "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    }
  }
}
