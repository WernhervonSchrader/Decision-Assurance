{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-assurance.example/schemas/production/health-report.schema.json",
  "title": "Health Report v0.5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "checked_at", "ready", "components"],
  "properties": {
    "schema_version": {"const": "0.5.0"},
    "checked_at": {"type": "string", "format": "date-time"},
    "ready": {"type": "boolean"},
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "status", "critical"],
        "properties": {
          "component": {"type": "string", "minLength": 1},
          "status": {"enum": ["HEALTHY", "DEGRADED", "UNAVAILABLE"]},
          "reason_code": {"type": ["string", "null"]},
          "critical": {"type": "boolean"}
        }
      }
    }
  }
}
