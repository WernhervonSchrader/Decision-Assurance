{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-assurance.example/schemas/production/pilot-export-v0.9.schema.json",
  "title": "Decision Assurance signed pilot export manifest v0.9",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "export_id", "case_ref", "decision_id", "tenant_id", "generated_at", "software", "policy_versions", "event_schema_version", "members"],
  "properties": {
    "schema_version": {"const": "0.9.0"},
    "export_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "case_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "decision_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "generated_at": {"type": "string", "format": "date-time"},
    "event_schema_version": {"const": "1.0.0"},
    "software": {"type": "object", "additionalProperties": false, "required": ["version", "commit_sha"], "properties": {"version": {"type": "string", "minLength": 1}, "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}}},
    "policy_versions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "members": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string", "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*\\.json$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 2, "maximum": 10485760}}}}
  }
}
